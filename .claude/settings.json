{
  "plansDirectory": "docs/spec",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch(domain:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker stats *)",
      "Bash(git * blame *)",
      "Bash(git commit*)",
      "Bash(git * diff *)",
      "Bash(git * log *)",
      "Bash(git * ls-files *)",
      "Bash(git mv:*)",
      "Bash(git * show *)",
      "Bash(git * status *)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run ty*)",
      "Bash(uv sync:*)",
      "Bash(coredumpctl list *)",
      "Bash(journalctl --since \"5 days ago\")",
      "Bash(grep:*)",
      "Bash(ls *)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(grep * .env)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(rm -rf*)",
      "Bash(rm *)",
      "Bash(sudo*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git restore*)"
    ]
  }
}
